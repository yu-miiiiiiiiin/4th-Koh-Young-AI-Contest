"""Calculate sum(ct + solve_s + 10 * core) from a solver summary CSV."""

import argparse
import csv
from decimal import Decimal, InvalidOperation
from pathlib import Path


def calculate_score(path):
    totals = {name: Decimal(0) for name in ("ct", "solve_s", "core")}
    count = 0
    with path.open(encoding="utf-8-sig", newline="") as stream:
        reader = csv.DictReader(stream)
        missing = set(totals) - set(reader.fieldnames or [])
        if missing:
            raise ValueError(f"Missing columns: {', '.join(sorted(missing))}")
        for row in reader:
            for name in totals:
                try:
                    value = Decimal(row[name])
                except (InvalidOperation, TypeError):
                    raise ValueError(
                        f"Line {reader.line_num}: invalid {name}: {row[name]!r}"
                    ) from None
                if not value.is_finite() or value < 0:
                    raise ValueError(f"Line {reader.line_num}: {name} must be finite and nonnegative")
                if name == "core" and value != value.to_integral_value():
                    raise ValueError(f"Line {reader.line_num}: core must be an integer")
                totals[name] += value
            count += 1
    if not count:
        raise ValueError("CSV contains no data rows")
    return count, totals


def main():
    parser = argparse.ArgumentParser(
        description="Calculate total score: sum(ct) + sum(solve_s) + 10 * sum(core)."
    )
    parser.add_argument("csv_file", type=Path, help="Path to summary CSV")
    args = parser.parse_args()
    try:
        count, totals = calculate_score(args.csv_file)
    except (OSError, UnicodeError, csv.Error, ValueError) as exc:
        parser.exit(1, f"Error: {exc}\n")

    core_cost = totals["core"] * 10
    total = totals["ct"] + totals["solve_s"] + core_cost
    print(f"File          : {args.csv_file}")
    print(f"Datasets      : {count}")
    print(f"CT sum        : {totals['ct']:,.2f}")
    print(f"Solve time sum: {totals['solve_s']:,.2f}")
    print(f"Core sum      : {totals['core']:,.0f}")
    print(f"Core cost x10 : {core_cost:,.2f}")
    print(f"TOTAL SCORE   : {total:,.2f}")
    print("Lower is better. Based on the values stored in the CSV.")


if __name__ == "__main__":
    main()